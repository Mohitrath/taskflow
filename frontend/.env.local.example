# Production database and auth
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/taskflow?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret

# Optional AI task generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: only needed if using a separate API origin
NEXT_PUBLIC_API_URL=
